    {
      "id": "claim_7f637ae2ca9f4ee2b5143766bbafed3d",
      "statement": "`asyncio.CancelledError` is deliberately re-raised by `_run` without any terminal write: a shutting-down worker leaves the row in a running status and the API-side `recover_stale(worker_lease_seconds)` requeues it for another worker, which resumes the same on-disk workspace.",
      "evidence": [
        {
          "resource": "repo://app/core/storage.py#L345-L356",
