    {
      "id": "claim_730612f8b0d04bea9af93dc119fe4506",
      "statement": "`WorkerLoop._run` maps exceptions to exactly three terminal outcomes: `PipelineCancelled` → `cancelled`; `publisher.PushError` → `failed` with a 500-char-truncated error and a `push_result` of `status: failed` (wrapped in `contextlib.suppress`); `ingestion.IngestionError`/`OpenWikiRunError`/`packer.PackError` → `failed` with a 500-char-truncated error; and any other `Exception` → `failed` with `\"<TypeName>: <message>\"` truncated, also suppressed, because a runner must never die.",
      "evidence": [
        {
          "resource": "repo://app/services/packer.py#L12-L13",
          "version": "repo-lines-v1:sha256:edf7b2064297b7d081410a999fbf7d250769ed018e8266cdd1b572995b419480:"
