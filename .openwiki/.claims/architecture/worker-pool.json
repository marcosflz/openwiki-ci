        }
      ]
    },
    {
      "id": "claim_321a3705db334f9c8ec06b44c8f74429",
      "statement": "`WorkerLoop.stop()` cancels every runner task first and only then awaits them one by one with `CancelledError` suppressed, clearing `self._tasks` and stopping the provider proxy afterwards, so a runner waking up during shutdown cannot claim a new wiki while the others are being torn down.",
      "evidence": [
        {
          "resource": "repo://app/worker/loop.py#L58-L67",
          "version": "repo-lines-v1:sha256:f73491de3cb9f32a5216342da249d84d4121131f34a1939cad481409e2c43ad8:"
        }
      ]
    },
    {
      "id": "claim_5ecc015660ad4e5bbd478a5e2bf1dd03",
      "statement": "Because `run_openwiki` kills the CLI subprocess when `cancel_event` fires and `_run` re-raises `asyncio.CancelledError`, a worker shutdown never leaves an orphaned OpenWiki process and never marks the wiki terminal; the row is recovered by the API reaper instead.",
      "evidence": [
        {
          "resource": "repo://app/services/wiki_runner.py#L249-L261",
          "version": "repo-lines-v1:sha256:4ca9b8f109e425b803dfb13f50acbfe1f7f837a6295189bf42fead57c59124a8:"
        },
