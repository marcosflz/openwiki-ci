    {
      "id": "claim_5e573c914d5c406ea165f8008120b176",
      "statement": "Concurrency per container defaults to 1 and is intended to be scaled with worker replicas instead of internal parallelism, because each generation is a long-lived OpenWiki subprocess plus clone and workspace disk usage, while extra replicas share the same SQLite queue through the already-exclusive `claim_next`.",
      "evidence": [
        {
          "resource": "repo://app/core/config.py#L49-L64",
