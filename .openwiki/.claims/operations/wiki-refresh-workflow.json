    {
      "id": "claim_9b2751665ac4448dbec7dc77d9e7ea6d",
      "statement": "Every third-party action the workflow uses is pinned to a full commit SHA with a human-readable version comment (`actions/checkout` v4, `actions/setup-node` v4, `peter-evans/create-pull-request` v7).",
