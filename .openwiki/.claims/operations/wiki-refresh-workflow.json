    {
      "id": "claim_684f68526613431c99ce3d6e63a05e0b",
      "statement": "The wiki's output language and writing rules come from the committed brief `openwiki/INSTRUCTIONS.md` rather than from a workflow flag, because the CLI step passes no language option; the rules are the same three that `prepare_instructions` generates in the service — write every page in the requested language, leave identifiers, file paths, commands and API names untranslated, and prefer architecture and data flow over line-by-line commentary — and in the service a user-authored brief always wins while a generated one is written only when the repository ships none.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/openwiki-update.yml#L33-L36",
          "version": "repo-lines-v1:sha256:d58ef5f498c02b45776d67452c92ddb307313815a56beddaf62b0c62e897fa58:"
