    {
      "id": "claim_c1e0b0242ca94cf2956d77efbbb2f54c",
      "statement": "The deployment assumes a single host with a local volume: the queue is `app/core/storage.py`'s `JobStore` over SQLite (`openwiki.db`, WAL) and artifacts are a local `jobs/` tree, so multi-host scaling requires replacing that module with a backend such as Postgres that preserves the same method contract (`claim_next`, `heartbeat`, `complete`, `recover_stale`, `stats`, ...) plus a shared artifact volume.",
      "evidence": [
        {
          "resource": "repo://README.md#L397-L399",
          "version": "repo-lines-v1:sha256:fdf830eb68c8dc965e0aadafb589b0adf6afbe66c0b246673cf6c56eca4c866a:"
        },
        {
