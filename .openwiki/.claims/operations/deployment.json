        }
      ]
    },
    {
      "id": "claim_0bff927e64ed45289c52808e0b1caaf5",
      "statement": "Local, non-Docker execution uses the same entrypoints with the factory flag: `uv run uvicorn app.main:create_app --factory` for the API and `uv run python -m app.worker` for the worker, run as two processes that meet in the SQLite queue under the local data directory.",
      "evidence": [
        {
          "resource": "repo://README.md#L356-L362",
          "version": "repo-lines-v1:sha256:8df5ae853c5fd0e208d35b1d66b99e563c24ebf97d38bdd49c7ae3e7aa12b28f:"
