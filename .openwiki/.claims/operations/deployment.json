          "version": "repo-lines-v1:sha256:6c203b6ee94c90e64e0ab56fa746fee26450e0be1efa75ed408d37f42732258d:"
        }
      ]
    },
    {
      "id": "claim_45d1387ade854a8a8462dc523d040fbb",
      "statement": "The compose `worker` service defaults `JOB_TIMEOUT_MINUTES` to 60 while the code default of `Settings.job_timeout_minutes` is 45, so the effective per-generation timeout differs between a compose deployment and a local run.",
      "evidence": [
        {
          "resource": "repo://app/core/config.py#L40-L43",
          "version": "repo-lines-v1:sha256:1f72a38c518880470d331b36d0f0cd0fdd945634403fabeba46db7d9fa5f589a:"
