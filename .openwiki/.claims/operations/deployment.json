    },
    {
      "id": "claim_0f148e466b9c46679f17ac44b4c4a29d",
      "statement": "The image sets `DATA_DIR=/data`, `OPENWIKI_CONFIG_DIR=/data/.openwiki-config` and `OPENWIKI_TELEMETRY_DISABLED=1`, matching `Settings._default_data_dir()` which returns `/data` on Linux and `./data` on Windows for non-container runs.",
