    {
      "id": "claim_b9e83bcb37b6482896cdd9c89f53546b",
      "statement": "`.dockerignore` excludes `.git`, `.venv`, `data`, `tests`, `__pycache__`, `*.pyc`, `.pytest_cache`, `.env` and `*.egg-info` from the build context, keeping local secrets and volume state out of the image.",
