        }
      ]
    },
    {
      "id": "claim_b1bd7a314ab240c58ec6ea6bf1ab512d",
      "statement": "Single-container operation is supported by the same compose file: setting `RUN_LOCAL_WORKER=true` (shown commented in the `api` service or supplied via `.env`) makes `create_app`'s lifespan build a `WorkerLoop` inside the API process and stop it on shutdown, using exactly the same loop and pipeline as worker containers.",
      "evidence": [
        {
          "resource": "repo://README.md#L68-L69",
          "version": "repo-lines-v1:sha256:9faf4bb8259455e362acec65a5265e70867ef117d318dfeb509f1f77658ecc59:"
