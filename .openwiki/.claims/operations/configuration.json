    {
      "id": "claim_6253b21a166b4a54889e0a2fe6cabe79",
      "statement": "The deployed configuration diverges from the Settings defaults in ways that matter operationally: the Dockerfile bakes DATA_DIR=/data, OPENWIKI_CONFIG_DIR=/data/.openwiki-config and OPENWIKI_TELEMETRY_DISABLED=1, and docker-compose.yml sets JOB_TIMEOUT_MINUTES to 60 for the worker (versus the 45 default in Settings). OPENWIKI_VERSION is a build arg, so upgrading the CLI is an image rebuild.",
      "evidence": [
        {
          "resource": "repo://Dockerfile#L1-L45",
          "version": "repo-lines-v1:sha256:65c72557b93b1b117dc84436411fbe2e97cd744666542097ec67ccec6d55045e:"
