    {
      "id": "claim_db7af28bf03e48309157722e24ea1bdd",
      "statement": "JOB_RETENTION_HOURS (default 0) controls finished-wiki garbage collection: 0 keeps terminal wikis forever, and with a positive value the API lifespan calls purge_expired at startup to delete rows and workspaces of terminal wikis finished more than N hours ago.",
