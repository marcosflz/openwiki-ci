  "claims": [
    {
      "id": "claim_c9c97917369a4673b8993016395e759e",
      "statement": "Settings in app/core/config.py is the only configuration surface for the service's own knobs: it is a pydantic-settings BaseSettings that reads environment variables and a `.env` file from the working directory, ignores unknown variables (`extra=\"ignore\"`), and gives the process environment precedence over the `.env` file. OpenWiki's own variables (provider credentials, OPENWIKI_*) are deliberately not declared and are forwarded untouched.",
      "evidence": [
        {
          "resource": "repo://.env.example#L1-L25",
          "version": "repo-lines-v1:sha256:4c5211a69aa04cc519bfb482f059cc4c6880ae293e56941f9e0c78584a78e629:"
        },
        {
          "resource": "repo://app/core/config.py#L19-L45",
          "version": "repo-lines-v1:sha256:cf6a616c4d9f53bcf7fb8f9032d9cc70a36b4f4c3df4bd35c2901ebd0a9f2755:"
        }
      ]
    },
    {
      "id": "claim_aeb87f5caa7c49eb981c039cf137a065",
      "statement": "Provider credentials (OPENAI_API_KEY, ANTHROPIC_API_KEY, ...) are intentionally absent from Settings so the service owns no credential storage: build_env copies os.environ and overrides only service-owned variables, keeping provider config an environment change rather than a code change.",
      "evidence": [
        {
          "resource": "repo://app/core/config.py#L20-L25",
          "version": "repo-lines-v1:sha256:9a4b830baf35f73c84413a2eb565798f5a0f031a8f97e746c74ac382eaebc626:"
        },
        {
          "resource": "repo://app/services/wiki_runner.py#L41-L59",
          "version": "repo-lines-v1:sha256:4fce1f2b0a7dcc6897c062988453fc441877cea56fc816033fd1d4631331fc30:"
        }
      ]
    },
    {
      "id": "claim_5e56acef7d0541559f057def8eb779c6",
      "statement": "build_env always forces OPENWIKI_CONFIG_DIR to settings.resolved_config_dir, defaults OPENWIKI_TELEMETRY_DISABLED to \"1\" only when the environment does not already define it, sets OPENWIKI_PAGE_CONCURRENCY when a per-job concurrency is resolved, and finally applies worker-supplied overrides (used to point the CLI at the header-injecting proxy).",
      "evidence": [
        {
          "resource": "repo://app/services/pipeline.py#L98-L112",
          "version": "repo-lines-v1:sha256:b5e1041ebbbee93bf0bacd8af5a7ceba963f60f28209c3caf8e05be1d19dd3d4:"
        },
        {
          "resource": "repo://app/services/wiki_runner.py#L41-L59",
          "version": "repo-lines-v1:sha256:4fce1f2b0a7dcc6897c062988453fc441877cea56fc816033fd1d4631331fc30:"
        }
      ]
    },
    {
      "id": "claim_1c82ec9da4d44d5f895ffdde4fcf14c3",
      "statement": "Settings enforces configuration invariants at startup through field validators: default_page_concurrency must be 1–8 (the same range the API validates for per-wiki concurrency), job_timeout_minutes/max_upload_mb/max_concurrent_jobs/model_check_timeout_seconds/worker_lease_seconds/worker_reap_seconds must be >= 1, worker_poll_seconds and worker_progress_seconds must be > 0, compat_proxy_port must be within 0–65535, and push_author_name/push_author_email must be non-empty after strip().",
      "evidence": [
        {
          "resource": "repo://app/core/config.py#L94-L143",
          "version": "repo-lines-v1:sha256:52e801d267e13918238ae42b58a1c661ac89224dbe83063c7024010f2007502a:"
        },
        {
          "resource": "repo://app/schemas.py#L108-L113",
          "version": "repo-lines-v1:sha256:0948b15ae8af1f4791fe97b8d73baac56cca9b01f073d3bb60d1979512156714:"
        }
      ]
    },
    {
      "id": "claim_fd68b400c9fc4ea5a182564e4a00f42e",
      "statement": "wiki_artifact_dir is validated as a plain folder name — non-empty after strip, not \".\" or \"..\", and free of \"/\" and \"\\\" — because the value becomes a path component inside wiki.zip and a pathspec in `git add`. tests/test_wiki_state.py pins that \".openwiki\" is accepted and \"bad/name\" raises ValueError.",
      "evidence": [
        {
          "resource": "repo://app/core/config.py#L129-L135",
          "version": "repo-lines-v1:sha256:ce2d1547f94286287096aa333e1cd2e4cd103348c6b5d020729c543af72792da:"
