    {
      "id": "claim_9bd2146273a54517a0ca39b30d676d78",
      "statement": "Settings derives three paths consumed across the service: data_dir (DATA_DIR, defaulting to /data on POSIX and ./data on Windows via _default_data_dir), jobs_dir (data_dir/\"jobs\"), and resolved_config_dir (openwiki_config_dir when set, otherwise data_dir/\".openwiki-config\"), the latter being exported to the CLI and read by the passive health report.",
      "evidence": [
        {
          "resource": "repo://app/core/config.py#L12-L16",
          "version": "repo-lines-v1:sha256:9c7bfa5d27eada0314d16b3ce076dfe117bca2aa38722b60f85c41bfe851083a:"
