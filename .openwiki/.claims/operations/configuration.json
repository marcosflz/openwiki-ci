          "version": "repo-lines-v1:sha256:ec3d24a10fb9f8a5be5268cd8e01e646b988575e0dac7ccae6565d0b152a90a3:"
        }
      ]
    },
    {
      "id": "claim_b56b6439084d4ddb811551bff02f6401",
      "statement": "MAX_CONCURRENT_JOBS (default 1) sets how many generations a single worker container runs in parallel by creating that many `_runner` tasks, so horizontal scale comes from replicas sharing the SQLite queue rather than from raising this value.",
      "evidence": [
        {
          "resource": "repo://app/worker/loop.py#L50-L56",
          "version": "repo-lines-v1:sha256:26c66985e023b2d91d070acb8f2f3609301b35e71ce1fc521fb9c81d71f736d8:"
