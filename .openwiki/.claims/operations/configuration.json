        }
      ]
    },
    {
      "id": "claim_11e9528ce39f48b7bca2b44896fb77f7",
      "statement": "The service forces no OPENAI_COMPATIBLE_BASE_URL of its own unless header injection is needed: WorkerLoop.start only launches the loopback proxy when both OPENAI_COMPATIBLE_EXTRA_HEADERS and OPENAI_COMPATIBLE_BASE_URL are set, using COMPAT_PROXY_PORT (0 picks a free port) and publishing env_overrides so the CLI talks to the proxy.",
      "evidence": [
        {
          "resource": "repo://app/services/provider_proxy.py#L176-L199",
