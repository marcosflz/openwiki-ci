    },
    {
      "id": "claim_25de33673ab7411999a737fe136e5671",
      "statement": "WORKER_LEASE_SECONDS and WORKER_REAP_SECONDS define the recovery contract: the API's _reap_loop periodically calls JobStore.recover_stale(lease_seconds) to requeue claims with no heartbeat within the lease, so another worker resumes the same workspace; WORKER_POLL_SECONDS and WORKER_PROGRESS_SECONDS set the claim-polling and heartbeat cadence.",
      "evidence": [
        {
          "resource": "repo://app/core/storage.py#L345-L356",
          "version": "repo-lines-v1:sha256:0bc515054cd31cc2129d901d5d9de545e5d0a821001c26e4b6920b65148e00f1:"
        },
