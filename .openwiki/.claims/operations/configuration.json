    {
      "id": "claim_5fc020bd9c0a464faee09b39f139a5cd",
      "statement": "RUN_LOCAL_WORKER controls whether the API process also runs generations: when true, create_app's lifespan constructs a WorkerLoop inside the API (single-container/dev/tests); worker containers instead run `python -m app.worker`, which builds the same Settings and JobStore.",
      "evidence": [
        {
          "resource": "repo://app/main.py#L53-L74",
          "version": "repo-lines-v1:sha256:9fd1c80841316edcaafaa834b67a1759e54015fad67a6f19806c493f7c613d1d:"
        },
        {
