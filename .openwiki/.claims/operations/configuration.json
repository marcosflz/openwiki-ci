    {
      "id": "claim_fb6b2f535602474fafb67e9060d92840",
      "statement": "ALLOW_LOCAL_GIT (default false) is a development-only switch that gates cloning local paths and file:// URLs in validate_git_url; disabled, file:// is rejected with an explicit message and schemeless URLs are rejected as non-git URLs, which keeps the API from reading the container filesystem in production.",
      "evidence": [
        {
          "resource": "repo://app/core/config.py#L80-L82",
          "version": "repo-lines-v1:sha256:21b8a3afda574836dfb1ea4de9ace161f3f3d696935fdea9b18d27dd155939bb:"
