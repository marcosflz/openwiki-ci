          "version": "repo-lines-v1:sha256:f09780113afaf58a684101b719ffae19d755710185a69758a8b1b251e8d5226d:"
        },
        {
          "resource": "repo://app/worker/loop.py#L69-L76",
          "version": "repo-lines-v1:sha256:57e7387bf035171dc9e11066471e7d35cf1e24f429dcbc09cc4ee84eff165513:"
        }
      ]
    },
    {
      "id": "claim_e1c6ae4874804c7d9e0b440be95290e6",
      "statement": "MODEL_CHECK_TTL_SECONDS (default 30, and a negative value behaves as 0) caches GET /health/model results in ModelStatusCache; 0 disables the cache so every call probes the provider, while MODEL_CHECK_TIMEOUT_SECONDS (default 20) bounds the active probe and reports a timeout as status error.",
      "evidence": [
        {
          "resource": "repo://app/services/model_status.py#L384-L412",
          "version": "repo-lines-v1:sha256:6acb8775663b0af71dabe830c8083adaa360b6f042c8f134307d052cae807d21:"
