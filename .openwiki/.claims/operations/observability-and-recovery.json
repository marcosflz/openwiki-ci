    {
      "id": "claim_68d3d552733a4d89bd7ff46b9a805abf",
      "statement": "GET /wikis/{id}/logs?tail=N returns a plain-text tail of <data_dir>/jobs/<wiki_id>/logs.txt using deque(maxlen=tail), with tail defaulting to 50 and capped at MAX_LOG_TAIL = 2000, and returns an empty 200 body when the log file does not exist yet.",
