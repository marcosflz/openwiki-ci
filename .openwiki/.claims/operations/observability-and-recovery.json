    {
      "id": "claim_72746fc2a2804a2bad9554f239531993",
      "statement": "Terminal error strings are truncated to 500 characters at the catch sites, not in the schema: WorkerLoop._run stores str(exc)[:500] for domain failures (IngestionError, OpenWikiRunError, PackError) and f\"{type(exc).__name__}: {exc}\"[:500] for unexpected exceptions, so a runaway traceback can never bloat the row or a list response.",
      "evidence": [
        {
          "resource": "repo://app/worker/loop.py#L104-L126",
