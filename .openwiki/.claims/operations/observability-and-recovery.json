    {
      "id": "claim_6e71d6ef2af34250bf1a18208c9ee3ec",
      "statement": "GET /health is a passive, cost-free diagnostic that never contacts the model provider: it reports status, service version, openwiki_bin plus openwiki_found (resolved from the first argv token of the configured command), data_dir, the pool counters from store.stats() and the model block from describe_model().",
      "evidence": [
        {
          "resource": "repo://app/routers/health.py#L17-L35",
          "version": "repo-lines-v1:sha256:00cdecd70f96ce7df0b11685895796c2035b236c99ce2079c121d2b1580a7003:"
        },
        {
          "resource": "repo://app/services/wiki_runner.py#L34-L38",
          "version": "repo-lines-v1:sha256:68e7eb942e0faa85477e32bca06993ee82da3c5be275c2637b2dc7b8d5dfb413:"
        }
      ]
    },
    {
      "id": "claim_0bc95bc314c04140a775c3bf7c152caf",
      "statement": "JobStore.stats() computes the pool counters in a single query, counting queued rows, rows in RUNNING_STATUSES (fetching/generating/finalizing) and workers whose last_seen_at falls inside a configurable worker_ttl_seconds window that defaults to 120 seconds; /health calls it with no arguments, so 120 s is the effective liveness window for the worker counter.",
      "evidence": [
        {
          "resource": "repo://app/core/storage.py#L373-L383",
          "version": "repo-lines-v1:sha256:855d1af3a207312acf05d155a1aceb469da50e2ec7fad74529ce1a4afb0d1414:"
        },
        {
