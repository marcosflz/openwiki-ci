    {
      "id": "claim_eafd4f922fd24cc9a19793b23a745d81",
      "statement": "A wiki's progress string is derived from OpenWiki's own durable plan, not invented by the worker: read_run_state() parses openwiki/.run.json into {phase, total, completed, pending, current} and tolerates a missing or malformed file by returning None, format_progress() renders \"<completed>/<total> pages · <phase>\" (dropping the phase when absent), and the worker falls back to \"<n> pages written\" using packer.count_pages() until the plan exists.",
      "evidence": [
        {
          "resource": "repo://app/services/wiki_runner.py#L96-L137",
          "version": "repo-lines-v1:sha256:c20075e0ac1e3ccc847b85372c14e972b4c1f4078a2851a69517d79ecdcf3fb3:"
