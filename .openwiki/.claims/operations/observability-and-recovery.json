        }
      ]
    },
    {
      "id": "claim_575043917367450b96b7cad566292d31",
      "statement": "recover_stale is the only automatic path that returns a fetching/generating/finalizing row to queued: it clears claimed_by, claim_id, claimed_at, last_seen_at and cancel_requested while preserving attempts, which is why a worker that only loses its lease stops writing (complete() requires a matching claim_id) and another worker resumes the same workspace.",
      "evidence": [
