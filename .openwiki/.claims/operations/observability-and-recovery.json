          "version": "repo-lines-v1:sha256:85b2926bdd3745cea072607a5687a0a1583570f9e2765794cb12845f2bec7ca4:"
        }
      ]
    },
    {
      "id": "claim_8b991181369b4e299c1425702cf321ab",
      "statement": "describe_model() builds a passive, secret-free snapshot of the OpenWiki model configuration by merging <OPENWIKI_CONFIG_DIR>/.env under the process environment (environment wins), reporting provider/model/credential/base_url names and origins (environment, config or default), a base_url_warning with suggested_base_url when the base URL wrongly contains an endpoint path, and the extra-header names (never values) with any parse error for the OpenAI-compatible gateway setup.",
      "evidence": [
        {
          "resource": "repo://app/services/model_status.py#L121-L197",
          "version": "repo-lines-v1:sha256:e997e7b6ada171875b97244aaf28a36d908d8b7524c306f7b7c33fa5953593f2:"
        }
      ]
    },
    {
      "id": "claim_c2be854a8e2e4c82adf01eac6017300f",
      "statement": "GET /health/model performs the only provider-spending check and maps its status to HTTP: 200 for ok and unsupported, 503 for error and not_configured; results are memoized per app instance by ModelStatusCache for MODEL_CHECK_TTL_SECONDS (30 s default, 0 disables caching) and ?force=true bypasses the cache, with cached, checked_at, latency_ms and a redacted detail in the response.",
      "evidence": [
        {
          "resource": "repo://app/routers/health.py#L38-L49",
          "version": "repo-lines-v1:sha256:c5da0da887acb4ce4093ecfe947b660bd53146c94607e3c9599c807fb9ce90cc:"
