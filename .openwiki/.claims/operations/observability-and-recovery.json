    {
      "id": "claim_ae316106f12744fa93e5d358c26a7e27",
      "statement": "Three maintenance operations keep shared state bounded: purge_expired(JOB_RETENTION_HOURS) runs once at API startup and deletes terminal rows finished longer ago than the retention window together with their workspace, logs and zip (0, the default, disables it); recover_stale(WORKER_LEASE_SECONDS) re-queues running rows whose last heartbeat is older than the lease, at startup and on every _reap_loop tick; and prune_workers() runs on each tick with a 3600 s default age to drop stale workers-table registry entries.",
      "evidence": [
        {
          "resource": "repo://app/core/storage.py#L229-L240",
          "version": "repo-lines-v1:sha256:57baa631d1c71884efe15aed636f4ee43f9a0169393a22c568c616a80c3d30c3:"
