    {
      "id": "claim_f023041abda6487ea0edea067f8e0259",
      "statement": "A cancelled attempt leaves no downloadable artifact: `pipeline.run_pipeline` calls `check_cancel()` before `packer.pack_wiki`, and `GET /wikis/{id}/download` requires an existing `wiki.zip`, so a cancelled wiki answers `404 wiki is not ready (status=...)` until a later attempt packages the wiki.",
      "evidence": [
        {
          "resource": "repo://app/routers/wikis.py#L216-L231",
          "version": "repo-lines-v1:sha256:fd7a78bbe0daeac9cd1904c907441eeca705371bbaf7b4c63511af8c7f9199eb:"
