    {
      "id": "claim_73615998b1934ca58cf29b61bec23539",
      "statement": "`DELETE /wikis/{id}` removes the whole `<DATA_DIR>/jobs/<wiki_id>/` directory together with the row, so deleting a wiki also destroys the workspace and OpenWiki plan that made it resumable.",
      "evidence": [
