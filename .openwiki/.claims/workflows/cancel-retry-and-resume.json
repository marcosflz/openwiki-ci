    {
      "id": "claim_2b8dc802a3804219bf58542e9ab1c76f",
      "statement": "A cancel request cannot stop an orphaned claim: `recover_stale` requeues running rows with `cancel_requested=0`, so a wiki whose worker already died is resumed rather than cancelled, and there is no cancel path for it other than finishing and deleting the terminal row.",
      "evidence": [
