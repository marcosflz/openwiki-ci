  "claims": [
    {
      "id": "claim_f23de9dd75b8466fa096b956a44b2a51",
      "statement": "`JobStore.cancel` implements two different cancellation semantics: a `queued` wiki is cancelled immediately (`status='cancelled'`, `finished_at`, `error='cancelled before start'`), a running wiki (`fetching`/`generating`/`finalizing`) only gets `cancel_requested=True` so the status stays untouched, and a terminal or unknown wiki yields `\"not_running\"` / `\"not_found\"`; the router maps those to `200 cancelled`, `200 cancelling`, `409` and `404` respectively.",
      "evidence": [
        {
          "resource": "repo://app/core/storage.py#L386-L397",
          "version": "repo-lines-v1:sha256:0e45c6601726e7de8238ec13caed9c0acc98a10d6ac7d37a5af47d798cce3d3c:"
        },
        {
          "resource": "repo://app/routers/wikis.py#L146-L157",
          "version": "repo-lines-v1:sha256:0f190e2b2076bf06291976fb9e27631105d73059289cda02d324f185e08e7171:"
        }
      ]
    },
    {
      "id": "claim_fc6c15eaef264361a94a8262a34d9079",
      "statement": "Running cancellation is cooperative because `heartbeat` is the only delivery channel: it re-confirms `(wiki_id, claim_id)` is in `RUNNING_STATUSES`, refreshes `last_seen_at` and returns the row's `cancel_requested` as `cancel`; `WorkerLoop._track` turns a truthy `cancel` into `cancel_event.set()`, and `pipeline.report()`/`check_cancel()` raise `PipelineCancelled` on the same signal, so the worker learns about the cancel at most one `WORKER_PROGRESS_SECONDS` later.",
      "evidence": [
        {
          "resource": "repo://app/core/storage.py#L271-L308",
          "version": "repo-lines-v1:sha256:c0451c6dd807cded94d8ca706ded480fd6d1db5ae09ef36202e437e1669ec677:"
        },
