    {
      "id": "claim_21bff92a6c624a4bb45fabf959d7d9cd",
      "statement": "Resumption level 2 is OpenWiki's own plan file: `read_run_state` parses `openwiki/.run.json` into `{phase, total, completed, pending, current}` by counting `plan.pages[*].status == \"complete\"` and tolerates a missing, unparsable or oddly shaped file, and the service only ever reads that file (through `_track`, every `WORKER_PROGRESS_SECONDS`, for the `progress` column) — the CLI itself is what continues the pending pages when it re-runs in the reused workspace.",
      "evidence": [
        {
          "resource": "repo://app/services/wiki_runner.py#L96-L125",
          "version": "repo-lines-v1:sha256:048a0b6261934baf076e7cf3eab8d177fb89d26389387b1a6fb670d7752d95c0:"
        },
        {
          "resource": "repo://app/worker/loop.py#L139-L156",
