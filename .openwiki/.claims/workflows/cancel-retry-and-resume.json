    {
      "id": "claim_c7307bfbd55c4f7bb7f693721fac5470",
      "statement": "`JobStore.retry` accepts only `failed` or `cancelled` rows and requeues them by clearing both the result (`error`, `progress`, `finished_at`, `cancel_requested`) and the whole claim (`claimed_by`, `claim_id`, `claimed_at`, `last_seen_at`) while leaving `attempts` and the workspace on disk untouched; the router answers `409` for a non-retryable status (naming it in the detail) and `404` for an unknown id, and `202` with a `WikiAccepted` (`status: queued`) on success.",
      "evidence": [
        {
          "resource": "repo://app/core/storage.py#L399-L418",
          "version": "repo-lines-v1:sha256:0c268d0f3f2c2191393835127df6aa2e7b58ddc980537951f6f6331235dda061:"
        },
        {
