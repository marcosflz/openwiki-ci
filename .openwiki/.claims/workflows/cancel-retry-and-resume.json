    {
      "id": "claim_6cf277b0eac442929ca6a8f57f3f019d",
      "statement": "`run_openwiki` enforces cancellation on the CLI subprocess: `wait_for_process` waits concurrently on the stdout/stderr pump and `cancel_event.wait()` with `asyncio.wait(..., return_when=FIRST_COMPLETED)`, and when the cancel future wins it calls `process.kill()`, awaits the process, writes the log line `! openwiki killed: generation cancelled` and raises `OpenWikiRunCancelled`, which the pipeline re-raises as `PipelineCancelled` so the attempt is stored as a terminal `cancelled` row with a reason.",
      "evidence": [
        {
          "resource": "repo://app/services/pipeline.py#L102-L114",
          "version": "repo-lines-v1:sha256:23f16d51082d2d751ac974cd74ec78720d820010f308c77d221f23ddf4453c24:"
        },
