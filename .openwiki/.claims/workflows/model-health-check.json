        }
      ]
    },
    {
      "id": "claim_168951cbeef546baa66fc59de7d9d545",
      "statement": "`_response_error` classifies a failure body: an HTML `Content-Type` or a body starting with `<` produces `HTML page instead of JSON` plus the hint that OpenAI-compatible base URLs usually end in `/v1`, otherwise it extracts the provider message from `error.message`, `error` or `message` (truncated to 300 characters) and falls back to the first 200 characters of the raw body or `no error details`.",
      "evidence": [
        {
          "resource": "repo://app/services/model_status.py#L207-L243",
          "version": "repo-lines-v1:sha256:016b5309aedf6c355e7fd4b1892ac08dea23034fd0256542ba62e014c7b06631:"
