    {
      "id": "claim_e4dc721e17144f069e9872a9aa886af5",
      "statement": "When a `base_url_warning` exists, `_run` confirms the suggested root with `base_override` before advising it: failures during that confirmation are swallowed, and if the model answers the result stays `error` with the detail extended by `with that base the model answers correctly` and a recorded `latency_ms`; the doubled path is never probed.",
      "evidence": [
        {
          "resource": "repo://app/services/model_status.py#L450-L476",
