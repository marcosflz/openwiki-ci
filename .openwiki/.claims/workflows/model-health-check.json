    {
      "id": "claim_43f0720f4dde42aea5c5f6bcd81bfaf2",
      "statement": "Extra headers are merged last into the probe's header dict (`Content-Type`, then auth, then extras), so a configured gateway header can override anything including `Authorization`; for `openai-compatible` a `ValueError` from `parse_extra_headers` is reported as `status: error` with the parser message rather than raising, and `/health` lists only the sorted header names so their values never leak.",
      "evidence": [
        {
          "resource": "repo://app/services/model_status.py#L308-L312",
          "version": "repo-lines-v1:sha256:e20bfd811cdae2bd1df5f3d3538ebd5ddd1df514ad689e563d7e2eff4ce667f8:"
