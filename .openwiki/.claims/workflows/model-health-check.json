        }
      ]
    },
    {
      "id": "claim_506bc8bc0da249a9b0fe6560a7981db3",
      "statement": "`ModelStatusCache` is instantiated once per app in `create_app` and published as `app.state.model_cache`, so its TTL cache is per app instance (per uvicorn process) and a scaled deployment can issue one probe per replica per TTL window.",
      "evidence": [
        {
          "resource": "repo://app/main.py#L50-L51",
          "version": "repo-lines-v1:sha256:d1d8edf7c70d1e3ad4c9313da8e3cbdd1f1ba6d6aac666c26365f9176ad768f4:"
