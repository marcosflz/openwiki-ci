        {
          "resource": "repo://tests/test_model_status.py#L296-L325",
          "version": "repo-lines-v1:sha256:c9a77fe29693b375045ac801f43003d970173e117700d7401253b656fe945af2:"
        }
      ]
    },
    {
      "id": "claim_7ec52a24120442eaae7edeae42883a14",
      "statement": "The active probe talks to the upstream gateway directly with the same extra headers, deliberately bypassing the loopback header-injecting proxy, so `/health/model` keeps testing the endpoint the provider configuration names.",
      "evidence": [
