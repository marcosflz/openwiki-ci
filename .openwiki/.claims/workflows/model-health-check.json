        }
      ]
    },
    {
      "id": "claim_1563a199b19b49c5be43f840d0f2297a",
      "statement": "`_post_with_v1_hint` retries `{base}/v1{path}` when the first POST returns 404 or 405 and the base does not already end in `/v1`, and if that alternative succeeds it raises a `ProbeError` naming which base URL works and which setting to fix, because OpenAI SDKs (and therefore OpenWiki) build request URLs as `baseURL + path`.",
      "evidence": [
        {
          "resource": "repo://app/services/model_status.py#L246-L276",
          "version": "repo-lines-v1:sha256:16495ba6b929879587adc261362539cbc0e0aee009603fed6d283692bf279c47:"
