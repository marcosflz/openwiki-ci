    {
      "id": "claim_e565d50e949b4bbc8ed3724d634c2407",
      "statement": "`Settings` declares `model_check_ttl_seconds` default `30` with no validator (the cache clamps it) and `model_check_timeout_seconds` default `20` under the `_check_positive` validator, so a timeout below 1 second is rejected at startup because it would make any probe impossible.",
      "evidence": [
        {
          "resource": "repo://app/core/config.py#L101-L113",
          "version": "repo-lines-v1:sha256:05a48e49847f1b26856ec5fb3c7d3b5e364daff0d17e8b831edfe534d3b87f1a:"
