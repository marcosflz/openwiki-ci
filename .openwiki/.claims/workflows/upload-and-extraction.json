        }
      ]
    },
    {
      "id": "claim_db7c65228cab47dcbed4940180364ab7",
      "statement": "Link entries are rejected outright instead of resolved: `_extract_zip` recovers the Unix mode from `(info.external_attr >> 16) & 0o170000` and raises for a `0o120000` (symlink) member, while `_extract_tar` raises when `member.issym() or member.islnk()` — so hardlinks, which are not path traversals in name space, get their own check.",
      "evidence": [
        {
          "resource": "repo://app/services/ingestion.py#L314-L325",
          "version": "repo-lines-v1:sha256:635fe5d1e08751169f7fca0715811b4e314203e28fb31587aacfaa1590240b22:"
