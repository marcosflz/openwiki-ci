    },
    {
      "id": "claim_2c2df915659849a1bf4bc19bf78f358e",
      "statement": "`extract_archive` bounds decompression bombs with MAX_EXTRACTED_MB: both helpers sum the declared uncompressed sizes (`info.file_size`, `member.size`) over the full member list and raise `IngestionError(\"archive expands beyond the <N> MB limit\")` as soon as the total exceeds the budget, before `extractall` writes anything. This limit measures uncompressed bytes and is therefore independent of MAX_UPLOAD_MB, which measured the compressed body over HTTP.",
      "evidence": [
        {
          "resource": "repo://app/core/config.py#L40-L44",
          "version": "repo-lines-v1:sha256:a51fc2e38f828fca9ab0505d7f4f22dd4f1a3f639508d5b212f637793ea1a00b:"
