    {
      "id": "claim_13aa4806ab834c9780cea8cb2bd2fad6",
      "statement": "`_extract_tar` extracts with `tf.extractall(dest, members=members, filter=\"data\")` and falls back to `tf.extractall(dest, members=members)` on `TypeError` because Python before 3.11.4 has no extraction filters; since the fallback removes the library hardening, the manual `_check_member_path`, link and size pre-checks — not the `filter` argument — are the real security boundary, and ZIP extraction (which has no equivalent library filter) always depends on its own manual pre-pass.",
      "evidence": [
        {
          "resource": "repo://app/services/ingestion.py#L314-L325",
          "version": "repo-lines-v1:sha256:635fe5d1e08751169f7fca0715811b4e314203e28fb31587aacfaa1590240b22:"
        },
