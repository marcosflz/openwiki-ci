        }
      ]
    },
    {
      "id": "claim_40eda8f5ab384c649191d47a710c3bbd",
      "statement": "`_fetch` always ends with `ingestion.ensure_git_repo(repo_dir)` for both source types; it returns False immediately when `.git` exists and otherwise runs `git init --quiet`, `git add --all` and `git commit --allow-empty -m \"Import source for OpenWiki\"` under the fixed `openwiki-service` identity, returning True. The repository is necessary because OpenWiki versions its Claim evidence through git and diffs against the commit in `openwiki/.last-update.json`, so an uploaded archive with no history must be given one synthetic commit.",
      "evidence": [
        {
          "resource": "repo://app/services/ingestion.py#L229-L245",
          "version": "repo-lines-v1:sha256:b09c5651fc9cb6247f5a4600e4af97cb2c8d9a67b651fe6182abc0e6a0697b44:"
        },
        {
