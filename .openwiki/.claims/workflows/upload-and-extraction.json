    {
      "id": "claim_46d8ae27d2264709a5bbc6cf64874ae9",
      "statement": "After every successful extraction `_normalize_single_root` fights the forge's wrapper folder: it returns unless `dest` holds exactly one entry, returns when that entry is a file or is named `.git`, and otherwise renames each child of that directory into `dest` and removes the empty wrapper. It normalizes a single level only, so a deeper nesting survives.",
      "evidence": [
        {
          "resource": "repo://app/services/ingestion.py#L298-L299",
          "version": "repo-lines-v1:sha256:6bb3bdd7b8642fd0986d79082f845f7cd4ae57bc1a51a1c89d59a2305f142900:"
