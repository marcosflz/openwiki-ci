  "claims": [
    {
      "id": "claim_033c239256744180a1f77d89b41419b2",
      "statement": "POST /wikis/upload is the archive alternative to POST /wikis: it accepts a multipart `file` plus optional `language`, `concurrency` (1..8) and `mode` (auto/init/update) form fields, normalizes the uploaded name with `Path(file.filename or \"upload\").name` so a client-supplied path cannot escape the job directory, and answers 202 WikiAccepted with `source` = {\"type\": \"upload\", \"filename\": <basename>, \"archive\": \"upload<suffix>\"}.",
      "evidence": [
        {
          "resource": "repo://app/routers/wikis.py#L92-L135",
          "version": "repo-lines-v1:sha256:ac88f339fdd1948813e77c07803004c07f5c3088d3cb368e89b6c0173afd355d:"
        },
        {
          "resource": "repo://app/schemas.py#L130-L135",
          "version": "repo-lines-v1:sha256:c4c3476a2bdc9d666bafe91de8f22e87a1424ffaea3e06cf06a8848d3e68582a:"
        }
      ]
    },
    {
      "id": "claim_8e8679b49fab41f2bf09aae28958526a",
      "statement": "The upload endpoint validates the archive suffix before creating any job row: `ingestion.archive_suffix` lowercases the filename and returns the longest matching entry of SUPPORTED_ARCHIVE_SUFFIXES (`.zip`, `.tar`, `.tar.gz`, `.tgz`, `.tar.bz2`, `.tbz2`, `.tar.xz`, `.txz`), and a `None` result is rejected with 422 listing the supported suffixes.",
      "evidence": [
        {
          "resource": "repo://app/routers/wikis.py#L106-L115",
          "version": "repo-lines-v1:sha256:f97b109e1b20b6b71d3f9a122a7d969ca28924bdc4373b3371ebbbf5a1a3b78d:"
        },
        {
