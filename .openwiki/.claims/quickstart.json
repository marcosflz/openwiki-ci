    {
      "id": "claim_4c697447a080473c80adf1fd703df486",
      "statement": "Settings deliberately does not declare model provider credentials such as OPENAI_API_KEY or ANTHROPIC_API_KEY: they remain in the process environment and are forwarded to the OpenWiki subprocess untouched, so configuration is read from environment variables and .env with extra variables ignored.",
