    {
      "id": "claim_0af0e212b40748ec934cdfbc915234cd",
      "statement": "The repository's own wiki is refreshed by the scheduled GitHub Actions workflow .github/workflows/openwiki-update.yml: it runs daily and on workflow_dispatch with contents/pull-requests write permissions, checks out with fetch-depth 0 so an incremental `openwiki code --update` can diff against the last documented commit, installs a pinned openwiki@0.6.0 (plus optional mermaid/jsdom), deletes the transient openwiki/.run.json, and opens a pull request over openwiki, AGENTS.md, CLAUDE.md and the workflow path itself, propagating a failed OpenWiki run as a failed job.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/openwiki-update.yml#L1-L82",
          "version": "repo-lines-v1:sha256:e4ca7c9452a76105248189116a206aca33b19be6c4411af053c2c84bfa6164ad:"
        }
      ]
    },
    {
      "id": "claim_8963ae35eb32469790bb124e196785e1",
      "statement": "The service's public HTTP surface is eleven endpoints: POST /wikis (git source), POST /wikis/upload (multipart archive), GET /wikis, GET /wikis/{id}, GET /wikis/{id}/logs, GET /wikis/{id}/download, POST /wikis/{id}/cancel, POST /wikis/{id}/retry, DELETE /wikis/{id}, GET /health and GET /health/model, with interactive documentation at /docs and the API published on port 8000.",
