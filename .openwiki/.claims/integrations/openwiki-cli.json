    {
      "id": "claim_77d84dec01a54913984d6aaccb62ca38",
      "statement": "Process termination races the output pump against cancel_event under an asyncio.wait timeout of job_timeout_minutes*60: a cancel kills and waits then raises OpenWikiRunCancelled, a timeout kills and waits then raises OpenWikiRunError, a non-zero exit raises OpenWikiRunError, and asyncio.CancelledError during worker shutdown kills and waits before re-raising so no orphan process survives.",
      "evidence": [
        {
          "resource": "repo://app/services/wiki_runner.py#L220-L264",
          "version": "repo-lines-v1:sha256:8d4176da7ef0bb3309eadf1b304b9022324c7bb806542b593f50309b8c4fafa5:"
        }
      ]
    },
    {
      "id": "claim_a942161a6aa74c6f90e3dfa3691319fe",
      "statement": "read_run_state tolerantly parses openwiki/.run.json into {phase, total, completed, pending, current} by counting plan.pages entries with status \"complete\" and taking current from the first unfinished page, returning None on a missing or unparsable file and a zeroed summary on unexpected shapes; format_progress turns that into strings like \"2/7 pages · generating\" or \"N pages written\".",
      "evidence": [
        {
          "resource": "repo://app/services/wiki_runner.py#L96-L137",
          "version": "repo-lines-v1:sha256:c20075e0ac1e3ccc847b85372c14e972b4c1f4078a2851a69517d79ecdcf3fb3:"
        },
        {
