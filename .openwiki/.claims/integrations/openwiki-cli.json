          "version": "repo-lines-v1:sha256:b7b2797b56b8e309c309cff0804f614753843d01904ce3683253a16fa4a928a1:"
        }
      ]
    },
    {
      "id": "claim_826204428a29434b8338b5b53e24276c",
      "statement": "WorkerLoop._track polls read_run_state through asyncio.to_thread every worker_progress_seconds, announces the plan once, falls back to packer.count_pages when there is no plan, and sets the shared cancel_event when the heartbeat reports a lost lease or a cancel request.",
      "evidence": [
        {
          "resource": "repo://app/services/packer.py#L16-L21",
