    {
      "id": "claim_12191a71f3504c0d8e89dd9160c45d6a",
      "statement": "CLI output is streamed line by line into logs_path with a UTC [HH:MM:SS] stamp, redact_text applied against known secrets and URL/auth-header credentials, and an explicit flush per line, making that file the log the API exposes.",
