  "claims": [
    {
      "id": "claim_d53623858175414aa06058ce767f227e",
      "statement": "app/services/wiki_runner.py is the single module that knows how to invoke the OpenWiki CLI; all other modules import its helpers, so an upgrade is a container rebuild and a CLI interface change only requires editing this module.",
      "evidence": [
        {
          "resource": "repo://app/services/pipeline.py#L23-L29",
          "version": "repo-lines-v1:sha256:2bb5b34a627fcf118f6f9d2ea7686db89be1809a037d92af145f1ff6907709e4:"
        },
        {
          "resource": "repo://app/services/wiki_runner.py#L1-L6",
          "version": "repo-lines-v1:sha256:b62cf93b03abc60e50479013aa511bd10888e5d2561beb888026320f09697994:"
        },
        {
          "resource": "repo://app/worker/loop.py#L21-L21",
          "version": "repo-lines-v1:sha256:8a6db39e5e68ef0495d6b21d82873daf6c15c7a60848855aab135aa8e4e149b5:"
        }
      ]
    },
    {
      "id": "claim_4b5b4d8b57854c1d9187c291c7e64eef",
      "statement": "run_openwiki builds the effective command as split_command(settings.openwiki_bin) + [\"--{mode}\", \"-p\"], i.e. one-shot openwiki --init -p or openwiki --update -p, and raises OpenWikiRunError when the resulting argv[0] is empty.",
      "evidence": [
        {
          "resource": "repo://app/services/wiki_runner.py#L180-L182",
          "version": "repo-lines-v1:sha256:5d89699e2890db62ffaa5284a9835d0bb5a34d0dcdf3f89cad2bfc615cb996ba:"
        }
      ]
    },
    {
      "id": "claim_4b44bf9f93764c45b4ea0480cc942ca8",
      "statement": "split_command tokenizes the single OPENWIKI_BIN string with shlex (posix=False and quote stripping on Windows so backslashes survive), which lets OPENWIKI_BIN carry an interpreter plus script; GET /health reuses it to resolve the binary for its openwiki_found probe.",
      "evidence": [
        {
          "resource": "repo://app/routers/health.py#L22-L35",
          "version": "repo-lines-v1:sha256:200c1b48e964927afffce2879f061b92665655f8656e5efb5698b828d0afd9e8:"
        },
        {
          "resource": "repo://app/services/wiki_runner.py#L34-L38",
          "version": "repo-lines-v1:sha256:68e7eb942e0faa85477e32bca06993ee82da3c5be275c2637b2dc7b8d5dfb413:"
        }
      ]
    },
    {
      "id": "claim_c5f45041895e428795f1a47140acbc9c",
      "statement": "build_env copies os.environ and overrides only service-owned variables: OPENWIKI_CONFIG_DIR is always set to resolved_config_dir, OPENWIKI_TELEMETRY_DISABLED defaults to \"1\" but respects an explicit environment value, OPENWIKI_PAGE_CONCURRENCY is set only when page_concurrency is truthy, and the extra/env_overrides mapping is applied last with highest priority.",
      "evidence": [
        {
          "resource": "repo://app/services/wiki_runner.py#L41-L59",
          "version": "repo-lines-v1:sha256:4fce1f2b0a7dcc6897c062988453fc441877cea56fc816033fd1d4631331fc30:"
        }
      ]
    },
    {
      "id": "claim_fa0098539b04406997d277ed9e9b08a2",
      "statement": "Provider credentials are deliberately not declared in Settings; they stay in the process environment and are forwarded untouched to the CLI subprocess, and resolved_config_dir is openwiki_config_dir or <data_dir>/.openwiki-config.",
