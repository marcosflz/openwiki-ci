    {
      "id": "claim_894e7e9bece34daebce62731eaabcc88",
      "statement": "run_openwiki starts the CLI with asyncio.create_subprocess_exec using cwd=repo_dir, stdin=DEVNULL and stderr merged into stdout, and raises OpenWikiRunError(\"OpenWiki binary not found\") when the executable cannot be spawned.",
