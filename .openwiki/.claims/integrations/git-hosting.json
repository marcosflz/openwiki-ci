    {
      "id": "claim_b20db7f0c3dd4a15ba635fb4c789e087",
      "statement": "clone_git(url, dest, *, ref, token) removes any pre-existing dest and always clones shallow and tag-free (git clone --depth 1 --no-tags): without a ref it clones the default branch directly; with a ref it first tries git clone --depth 1 --no-tags --branch <ref> --single-branch, and because --branch cannot check out a raw commit SHA an IngestionError from that attempt is swallowed, the partial dest is deleted, and the fallback runs a plain shallow clone followed by git fetch --depth 1 origin <ref> and git checkout --quiet FETCH_HEAD. A failure in the fallback propagates as IngestionError; the workspace it leaves is a detached checkout.",
      "evidence": [
        {
          "resource": "repo://app/services/ingestion.py#L167-L206",
          "version": "repo-lines-v1:sha256:5fc561266029429fbd58d52410eab9d471d499d475e008ce2a60be4adb2ce9bb:"
