    {
      "id": "claim_330487666c8641b4959efa34e9d6cb6d",
      "statement": "git is an explicit external dependency of the service: the Dockerfile installs the git package because repositories must be cloned, and only two modules drive the binary - app/services/ingestion.py owns the git execution layer and URL validation, and app/services/publisher.py imports that layer to stage, commit and push the generated wiki.",
      "evidence": [
        {
          "resource": "repo://Dockerfile#L14-L20",
          "version": "repo-lines-v1:sha256:f6ddcb37c2048e7dd58c66a81ad9b9460c472efeffd89e9bb729f36dce62be04:"
        },
