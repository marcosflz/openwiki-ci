    {
      "id": "claim_5b3d78a18fc147c4bf14053b35e85413",
      "statement": "validate_git_url(url, *, allow_local) is the single owner of git URL acceptance rules and returns the URL unchanged on success: scp-like SSH URLs (git@host:org/repo.git) are always accepted verbatim; http, https, ssh and git schemes require a non-empty netloc; file:// URLs, Windows drive paths and bare local paths are accepted only when allow_local (ALLOW_LOCAL_GIT) is enabled and, for bare paths, only when the path exists; any other scheme raises IngestionError. Rejection messages pass the URL through redact_url so embedded credentials are masked.",
      "evidence": [
        {
          "resource": "repo://app/core/util.py#L14-L17",
          "version": "repo-lines-v1:sha256:a72cc748c2c8bae5ae66ac184de64efe21ac9afb1bc17c3b408b8b72557b67f6:"
        },
        {
