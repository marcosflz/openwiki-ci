    {
      "id": "claim_b5cc7d5b73c449bdbeb680f6f7639e73",
      "statement": "publish_wiki uses git exit codes as outcomes, and only its two network commands carry the authentication prefix. git diff --cached --quiet via run_git_status decides whether anything is staged (0 = nothing, 1 = staged change, above 1 = PushError); a commit is created with the per-command author identity and either push.message or the mode default 'docs: generate OpenWiki wiki' / 'docs: update OpenWiki wiki'; git rev-parse HEAD captures the commit id; git ls-remote --quiet against refs/heads/<branch> (60 s) returning the same commit with nothing staged yields {'status': 'no_changes'} without pushing, and a failed or empty ls-remote yields None rather than an error so it can never block a push; otherwise git push --quiet <url> HEAD:refs/heads/<branch> (300 s) yields {'status': 'pushed'} with branch and commit. git_auth_prefix is prepended only to the ls-remote lookup and the push, while add, diff, commit and rev-parse are local commands that run without it.",
      "evidence": [
        {
          "resource": "repo://app/services/publisher.py#L141-L159",
          "version": "repo-lines-v1:sha256:6b38aa1f80ae35783d82a752e5dffd8af421daa939f12a62f7ac2c8d9a0dcd24:"
