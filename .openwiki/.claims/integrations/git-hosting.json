    {
      "id": "claim_f2e910487213494fa4a77865f382b9b7",
      "statement": "Token authentication for git over HTTPS uses one HTTP header and no URL credentials: git_auth_prefix(url, token) emits ['-c', 'http.extraHeader=Authorization: Basic <base64(username:token)>'], returns an empty list when there is no token, and raises IngestionError when a token is combined with a non-http(s) URL. token_basic_header chooses the username per forge from the lowercased netloc: GitHub x-access-token, GitLab oauth2, Bitbucket x-token-auth, and oauth2 as the fallback for Gitea, Forgejo and generic or self-hosted hosts.",
      "evidence": [
