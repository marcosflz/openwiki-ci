    {
      "id": "claim_ed16357bae804bccb3004b34e22de7d2",
      "statement": "ensure_full_history(repo_dir, *, url, token) repairs the shallow-clone versus --update conflict: it returns False without network access when <repo>/.git/shallow is absent, otherwise runs git fetch --quiet --unshallow origin (600 s, authenticated with git_auth_prefix) and returns True. A --depth 1 clone does not contain the commit recorded in openwiki/.last-update.json, so without it an --update would diff against an empty history. The pipeline calls it only when the resolved mode is update.",
      "evidence": [
        {
          "resource": "repo://app/services/ingestion.py#L209-L226",
