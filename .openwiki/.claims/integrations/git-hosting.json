    {
      "id": "claim_1a98481b65ba481c9ed6a315a48ada6a",
      "statement": "publish_wiki resolves the target branch, exposes the artifact directory, stages only the wiki, and pushes. _target_branch uses push.branch when given, otherwise git symbolic-ref --short -q HEAD, raising PushError('push.branch is required when the source is checked out at a tag or commit') for the detached checkout left by the FETCH_HEAD fallback, and validates the name with git check-ref-format --branch. _expose_artifact_dir renames the CLI's hardcoded openwiki/ to WIKI_ARTIFACT_DIR, replacing an existing tree there. Staging uses git add --all --force -- <artifact_dir> :(exclude)<artifact_dir>/.run.json so the transient resume state is never committed.",
      "evidence": [
        {
          "resource": "repo://app/services/publisher.py#L109-L138",
          "version": "repo-lines-v1:sha256:2a2a5add6b0b42e561a86b62e88471c1d897c49efd8837c00b34caeabc483e27:"
