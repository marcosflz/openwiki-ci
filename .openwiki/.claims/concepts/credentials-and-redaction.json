  "claims": [
    {
      "id": "claim_aa4354aa8ccb478795111646a9941f23",
      "statement": "A PAT is transported to git only as an HTTPS `Authorization: Basic` header through the `git -c http.extraHeader=...` prefix built by `git_auth_prefix`, which returns an empty prefix when there is no token and raises `IngestionError` when a token is combined with a non-http(s) URL, so credentials are never embedded in the remote URL.",
      "evidence": [
        {
          "resource": "repo://app/services/ingestion.py#L77-L94",
          "version": "repo-lines-v1:sha256:67624e87c3b894c0a629210db7eae0f31ad29bf9dde074c8b3db080fb74488e7:"
        },
        {
          "resource": "repo://app/services/ingestion.py#L97-L106",
          "version": "repo-lines-v1:sha256:dd10f63679699bce35e3c581dd4288c5c6ac4b75e027b32a31bf9ffaeef96d25:"
        },
        {
          "resource": "repo://tests/test_push.py#L17-L23",
          "version": "repo-lines-v1:sha256:2cdf647250ce6bad9fd31e400654bf77ce1bc32aa4a60fe74beccf5c2113dbdb:"
        }
      ]
    },
    {
      "id": "claim_cae067c912f74918a3c3ed804e55f86c",
      "statement": "`token_basic_header` selects the username placed next to the token as the Basic password by matching a lowercased host substring: `github` -> `x-access-token`, `gitlab` -> `oauth2`, `bitbucket` -> `x-token-auth`, and anything else (Gitea, Forgejo, generic/self-hosted) -> `oauth2`, so the mapping is heuristic and extension means editing the function, not its callers.",
      "evidence": [
        {
          "resource": "repo://app/services/ingestion.py#L77-L94",
          "version": "repo-lines-v1:sha256:67624e87c3b894c0a629210db7eae0f31ad29bf9dde074c8b3db080fb74488e7:"
        },
