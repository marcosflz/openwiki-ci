    {
      "id": "claim_6eb9065dea054b908179131cd006f1b2",
      "statement": "The active probe `GET /health/model` is the only place a provider credential is used, and it redacts failures: probe errors are passed through `redact_text(str(exc), (credential,))` and the reported `endpoint` through `redact_url`, so a provider key echoed in an HTTP error never reaches the response body.",
      "evidence": [
        {
          "resource": "repo://app/services/model_status.py#L491-L527",
          "version": "repo-lines-v1:sha256:963af1422bc48e9d19cf9966440d7224abc0e5505fd07839e2e464653896b730:"
