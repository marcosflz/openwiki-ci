        }
      ]
    },
    {
      "id": "claim_a359d8032f034c6b9d7b6462df0aec80",
      "statement": "`POST /wikis` rejects with 422, before creating any job, a token combined with a non-http(s) URL, a push over `git@`/`ssh://` or `git://`, and an http(s) push without a token, so the protocol policy for credentials is enforced at submission time in addition to inside `git_auth_prefix`.",
      "evidence": [
        {
          "resource": "repo://app/routers/wikis.py#L50-L89",
          "version": "repo-lines-v1:sha256:162e5521a337df5b0e4d39996afb39e20a862fbc1db45e284811ad7bb2b1bb50:"
