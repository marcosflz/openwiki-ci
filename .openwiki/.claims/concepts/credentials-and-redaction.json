    {
      "id": "claim_af3000877b4e4430ab6c37dbb24bf79c",
      "statement": "The raw token is persisted in the job's `source` JSON column of `<data_dir>/openwiki.db` (`/data/openwiki.db` in containers) so that `POST /wikis/{id}/retry` can re-clone a private repository without the client resending the token; the token is never part of a response model and `wiki_to_view` exposes only `source_url = redact_url(source['url'])`.",
      "evidence": [
        {
          "resource": "repo://app/core/storage.py#L59-L88",
          "version": "repo-lines-v1:sha256:79db9287318cccd57284f47ff072e2b98f353533623e41b4f65427a5b6a37ae0:"
