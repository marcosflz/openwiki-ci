          "version": "repo-lines-v1:sha256:00cdfafc5def8b392c198a7ba79354a28f2428230edd7322c8262170e805d1c7:"
        }
      ]
    },
    {
      "id": "claim_b0c0418eb7464fe8ba56ad81029c5014",
      "statement": "`GET /health` reports model configuration without values: `describe_model` returns the credential variable name plus `credential_present`/`credential_source` and not the credential itself, redacts `base_url` with `redact_url`, and lists extra OpenAI-compatible headers as sorted header names only.",
      "evidence": [
        {
          "resource": "repo://app/routers/health.py#L17-L35",
          "version": "repo-lines-v1:sha256:00cdecd70f96ce7df0b11685895796c2035b236c99ce2079c121d2b1580a7003:"
