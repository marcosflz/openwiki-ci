    {
      "id": "claim_a72116790de74eb6a14d1ab792bd40b2",
      "statement": "The publisher reuses the same token-bearing git prefix as the clone path: the pre-push remote lookup `git ls-remote` and the `git push HEAD:refs/heads/<branch>` both prepend `git_auth_prefix(url, token)` and are run with `secrets=(token,)`, so credential handling is uniform across clone, unshallow, lookup and push.",
      "evidence": [
        {
          "resource": "repo://app/services/ingestion.py#L209-L226",
          "version": "repo-lines-v1:sha256:cd81cb938ad3fc8663b62b4cd7acf922a4936bea7ca0380d6a52cefa24a41b49:"
