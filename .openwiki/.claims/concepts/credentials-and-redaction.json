    {
      "id": "claim_2c7dbf0d44dc4f11a28a9e3c32be5aae",
      "statement": "The API itself has no authentication: neither `create_app` nor the routers install an auth dependency, so the README positions the service for an internal network or behind an authenticated reverse proxy, with a bearer-token check as the next step.",
      "evidence": [
