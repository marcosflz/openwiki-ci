# --- Model provider (required by OpenWiki) ---------------------------------
# Pick one provider; full list at https://github.com/langchain-ai/openwiki#model-providers
# OPENWIKI_PROVIDER=openai
# OPENAI_API_KEY=sk-replace-me
# OPENWIKI_MODEL_ID=gpt-5.6-terra

# Alternative providers:
# OPENWIKI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
#
# OPENWIKI_PROVIDER=openrouter
# OPENROUTER_API_KEY=...
#
# OPENWIKI_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_API_KEY=ollama
# OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:11434/v1
# OPENWIKI_MODEL_ID=llama3.2

# --- Cabeceras extra para gateways OpenAI-compatible (opcional) -------------
# Algunos gateways exigen que el cliente se identifique con cabeceras propias
# que OpenWiki no envía; el servicio arranca un proxy loopback que las inyecta.
# Ejemplo OpenCode Go (https://opencode.ai/docs/go/):
# OPENAI_COMPATIBLE_BASE_URL=https://opencode.ai/zen/go/v1
# OPENAI_COMPATIBLE_EXTRA_HEADERS={"x-opencode-session":"openwiki-service"}
# COMPAT_PROXY_PORT=9100

# --- Service tuning (optional) ---------------------------------------------
# JOB_TIMEOUT_MINUTES=45
# MAX_UPLOAD_MB=200
# MAX_CONCURRENT_JOBS=2
# DEFAULT_PAGE_CONCURRENCY=2
# JOB_RETENTION_HOURS=0
# MODEL_CHECK_TTL_SECONDS=30
# MODEL_CHECK_TIMEOUT_SECONDS=20
# WIKI_ARTIFACT_DIR=.openwiki
# PUSH_AUTHOR_NAME=openwiki-service
# PUSH_AUTHOR_EMAIL=openwiki-service@localhost
# ALLOW_LOCAL_GIT=false

# --- Worker pool (optional) -------------------------------------------------
# Single-container mode: run one worker inside the API process.
# RUN_LOCAL_WORKER=true
# WORKER_ID=            # defaults to the container hostname
# MAX_CONCURRENT_JOBS=1 # generations per worker container (scale with replicas)
# WORKER_POLL_SECONDS=2
# WORKER_PROGRESS_SECONDS=2
# WORKER_LEASE_SECONDS=180   # a claim without heartbeats is requeued
# WORKER_REAP_SECONDS=30     # stale-claim sweep interval in the API

# --- OpenWiki CLI version used by the image (build arg) --------------------
# OPENWIKI_VERSION=0.6.0
